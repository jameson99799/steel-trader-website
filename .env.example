# 服务器端口
PORT=3001

# JWT 密钥（生产环境请修改为随机字符串）
JWT_SECRET=your-secret-key-change-this-in-production
CRM_JWT_SECRET=your-separate-crm-secret-change-this-in-production
UNSUBSCRIBE_SECRET=your-unsubscribe-signing-secret-change-this-in-production

# 运行环境
NODE_ENV=production

# 船舶追踪 API Key（可选）
# 实时位置: https://aisstream.io 免费注册（WebSocket 实时流，无查询次数限制，无需续期）
# 船舶搜索: https://dashboard.vesselapi.com 免费注册（仅用于按船名/IMO/MMSI 搜索，1次查询/艘）
# 未配置时前台船信息功能使用内置演示数据（含真实船舶静态资料）。
AISSTREAM_API_KEY=
VESSEL_API_KEY=
