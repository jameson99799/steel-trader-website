# 服务器端口
PORT=3001

# JWT 密钥（生产环境请修改为随机字符串）
JWT_SECRET=your-secret-key-change-this-in-production
CRM_JWT_SECRET=your-separate-crm-secret-change-this-in-production
UNSUBSCRIBE_SECRET=your-unsubscribe-signing-secret-change-this-in-production

# 运行环境
NODE_ENV=production

# 船舶追踪 API Key（可选，均可在后台"船舶追踪 → API 配置"填写）
# 主数据源: SHIPXY_API_KEY — 船讯网（国内直连，搜索+实时位置），在 https://api.shipxy.com/v3/console/overview 注册申请
# 备用源:   AISSTREAM_API_KEY — aisstream.io（WebSocket 实时流）
#           VESSEL_API_KEY — vesselapi.com（按船名搜索）
# 未配置时前台船信息功能使用内置演示数据（含真实船舶静态资料）。
SHIPXY_API_KEY=
AISSTREAM_API_KEY=
VESSEL_API_KEY=
